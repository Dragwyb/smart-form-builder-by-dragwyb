        "attributes": {
          "columns": 2,
          "gap": {
            "size": 15,
            "unit": "px"
          },
          "columns_mobile": 1
        }
      },
      "project_brief": {
        "_id": "project_brief",
        "type": "file",
        "parentId": "row_files_uploads",
        "attributes": {
          "label": "Project Brief",
          "required": false,
